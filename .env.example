# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Remote VPS (same host as energotc): SSL is configured automatically in database/client.ts
# Do not append ?sslmode=prefer — pg v8 treats it as verify-full and fails on self-signed certs
DATABASE_URL=postgresql://postgres:password@93.115.53.29:5432/eori_platform

# Optional: set to "true" only if the server has a trusted CA certificate
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Session Configuration
# Name of the session cookie (default: 'session')
SESSION_COOKIE_NAME=session

# Session maximum age in seconds (default: 604800 = 7 days)
SESSION_MAX_AGE=604800

# Password Hashing Configuration
# Number of bcrypt rounds for password hashing (default: 12)
# Higher values are more secure but slower. Recommended: 10-14
BCRYPT_ROUNDS=12

# Node Environment
# Set to 'production' for production builds
# Set to 'development' for development (default)
NODE_ENV=development
